  {
    "id": "fn-auto",
    "type": "function",
    "z": "tab1",
    "name": "5 hieleras x 2 sensores",
    "func": "const hieleras = ['H-01','H-02','H-03','H-04','H-05'];\nconst sensores = ['A','B'];\nconst msgs = [];\nfor (const h of hieleras) {\n  for (const s of sensores) {\n    const r = Math.random();\n    let temp;\n    if (r < 0.85) temp = 2 + Math.random() * 6;\n    else if (r < 0.93) temp = 8.6 + Math.random() * 3;\n    else temp = 0.5 + Math.random() * 1.5;\n    msgs.push({ payload: { sensorId: 'S-' + h.slice(2) + '-' + s, hielera: h, temperatura: Math.round(temp * 10) / 10 } });\n  }\n}\nreturn [msgs];",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 120,
    "wires": [
      [
        "http-lecturas"
      ]
    ]
  },
  {
    "id": "fn-force",
    "type": "function",
    "z": "tab1",
    "name": "Todas criticas",
    "func": "const hieleras = ['H-01','H-02','H-03','H-04','H-05'];\nconst sensores = ['A','B'];\nconst msgs = [];\nfor (const h of hieleras) {\n  for (const s of sensores) {\n    const temp = s === 'A' ? 11.2 : 1.1;\n    msgs.push({ payload: { sensorId: 'S-' + h.slice(2) + '-' + s, hielera: h, temperatura: temp } });\n  }\n}\nreturn [msgs];",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 220,
    "wires": [
      [
        "http-lecturas"
      ]
    ]
  },
